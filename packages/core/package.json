{
  "name": "@openavg/core",
  "type": "module",
  "version": "0.1.1",
  "description": "A universal adventure game engine based on PixiJS",
  "author": {
    "name": "Panzer_Jack",
    "email": "panzer_jack@panzer-jack.cn",
    "url": "https://blog.panzer-jack.cn"
  },
  "license": "MPL-2.0",
  "homepage": "https://github.com/AINovel-Studio/OpenAVG",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINovel-Studio/OpenAVG.git"
  },
  "keywords": [
    "openavg",
    "avg",
    "visual-novel",
    "pixijs",
    "game-engine"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "publish": "npm publish --access=public",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@pixi/sound": "^6.0.0",
    "pixi.js": "^8.0.0"
  },
  "dependencies": {
    "@pixi/layout": "catalog:prod",
    "@pixi/ui": "catalog:prod",
    "@tweenjs/tween.js": "catalog:prod",
    "dayjs": "catalog:prod",
    "localforage": "catalog:prod",
    "pixi-filters": "catalog:prod"
  },
  "devDependencies": {
    "@pixi/devtools": "catalog:",
    "tsup": "catalog:dev",
    "typescript": "catalog:dev"
  }
}
