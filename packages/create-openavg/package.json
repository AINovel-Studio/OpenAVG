{
  "name": "@openavg/create-openavg",
  "type": "module",
  "version": "1.17.1",
  "packageManager": "pnpm@9.15.5",
  "description": "A CLI tool to create OpenAVG projects",
  "author": {
    "name": "Panzer_Jack",
    "email": "panzer_jack@panzer-jack.cn",
    "url": "https://blog.panzer-jack.cn"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "create-openavg": "index.js",
    "co": "index.js"
  },
