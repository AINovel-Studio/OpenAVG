    "cross-spawn": "catalog:",
    "eslint-plugin-format": "catalog:conflicts_dev_h1_3_1",
    "img-ascii-term": "catalog:",
    "mri": "catalog:",
    "picocolors": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:conflicts_dev_h5_9_3"
  }
