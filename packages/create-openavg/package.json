{
  "name": "@openavg/create-openavg",
  "type": "module",
  "version": "0.1.2",
  "packageManager": "pnpm@9.15.5",
  "description": "A CLI tool to create OpenAVG projects",
  "author": {
    "name": "Panzer_Jack",
    "email": "panzer_jack@panzer-jack.cn",
    "url": "https://blog.panzer-jack.cn"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "create-openavg": "index.js",
    "co": "index.js"
  },
  "engines": {
    "node": ">= 22"
  },
  "scripts": {
    "build": "tsup",
    "start": "tsup && pnpm img2ascii && node ./index.js",
    "img2ascii": "node ./scripts/img2ascii.js",
    "dev": "tsup --watch",
    "lint": "eslint . --fix",
    "publish": "npm publish --access=public",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@clack/prompts": "^0.11.0",
    "@types/node": "^22.17.0",
    "@vercel/detect-agent": "^1.0.0",
    "chalk": "^5.6.2",
    "cross-spawn": "^7.0.6",
    "eslint-plugin-format": "^1.3.1",
    "img-ascii-term": "1.0.0",
    "mri": "^1.2.0",
    "picocolors": "^1.1.1",
    "tsup": "^8.3.6",
    "typescript": "^5.9.3"
  }
}
